{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cruise-port-requests",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://soundcruise.jp",
    "TURNSTILE_EXPECTED_HOSTNAME": "soundcruise.jp",
    "TURNSTILE_EXPECTED_ACTION": "app_request"
  },
  "d1_databases": [
    {
      "binding": "REQUESTS_DB",
      "database_name": "cruise-port-requests",
      "database_id": "f39ebfce-a042-4914-9697-7e93c89f38b3",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "31001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "IP_REQUEST_RATE_LIMITER",
      "namespace_id": "31002",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ]
}
