    "migrate:local": "wrangler d1 migrations apply NEWS_DB --local",
    "collect:local": "node scripts/collect-local.mjs",
    "review:local": "node scripts/review-local.mjs",
    "admin:local": "node scripts/admin-local.mjs",
    "admin:plan": "node scripts/admin-plan.mjs",
    "health:local": "node scripts/health-local.mjs",
    "validate:final": "node scripts/final-validation.mjs",
    "manual:add": "node scripts/manual-add.mjs",
    "operator": "node scripts/operator.mjs",
    "rollout": "node scripts/rollout.mjs",
