{
  "name": "sound-cruise-news",
  "account_id": "a9f2a3e9fcb6d0f68fd2eaa9df909e33",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "NEWS_COLLECTION_MODE": "production",
    "NEWS_API_MODE": "production",
    "NEWS_SOURCE_IDS": "[\"shimamura\"]"
  },
  "triggers": {
    "crons": [
      "0 * * * *",
      "17 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "NEWS_DB",
      "database_name": "sound-cruise-news",
      "database_id": "13267817-d259-4fde-80d3-37766f8f3f11",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
