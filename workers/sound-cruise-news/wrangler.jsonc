{
  "name": "sound-cruise-news-local",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "NEWS_COLLECTION_MODE": "off",
    "NEWS_API_MODE": "local",
    "NEWS_LOCAL_ORIGINS": "[\"http://localhost:8765\",\"http://127.0.0.1:8765\"]"
  },
  "triggers": {
    "crons": []
  },
  "d1_databases": [
    {
      "binding": "NEWS_DB",
      "database_name": "sound-cruise-news-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "remote": false,
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "env": {
    "production": {
      "vars": {
        "NEWS_COLLECTION_MODE": "off",
        "NEWS_API_MODE": "off"
      },
      "triggers": {
        "crons": []
      }
    }
  }
}
