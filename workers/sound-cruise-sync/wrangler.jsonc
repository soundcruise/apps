{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sound-cruise-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://soundcruise.jp",
    "SYNC_ALLOWED_APP_IDS": "chord",
    "TURNSTILE_EXPECTED_HOSTNAME": "soundcruise.jp",
    "TURNSTILE_EXPECTED_ACTION": "sound_cruise_sync_start"
  },
  "d1_databases": [
    {
      "binding": "SYNC_DB",
      "database_name": "sound-cruise-sync",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "START_RATE_LIMITER",
      "namespace_id": "32001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
