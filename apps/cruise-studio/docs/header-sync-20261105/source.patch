@@ -212,0 +213,14 @@
+
+/* Home identity and existing Sync entry. */
+.studio-main #screen-home .studio-header { position:relative; padding:30px 0 25px; border-bottom:1px solid var(--studio-border-default); }
+.studio-header-title { display:flex; align-items:center; gap:20px; }
+.studio-header-eyebrow { display:block; margin-bottom:12px; color:var(--studio-text-muted); font-size:10px; font-weight:600; letter-spacing:.18em; }
+.studio-header-eyebrow span { color:var(--studio-accent-text); padding:0 5px; }
+.studio-main #screen-home .studio-header h1 { margin:0; font-size:clamp(28px,3.1vw,42px); letter-spacing:.06em; font-weight:600; }
+.studio-main #screen-home .studio-header > p { margin:12px 0 20px; color:var(--studio-text-muted); letter-spacing:.06em; }
+.studio-header-sync { display:grid; place-items:center; width:42px; height:42px; flex:none; border:1px solid var(--studio-border-default); border-radius:10px; color:var(--studio-text-primary); background:var(--studio-control); cursor:pointer; }
+.studio-header-sync svg { width:23px; height:23px; }
+.studio-header-sync:hover { background:var(--studio-control-hover); }
+.studio-header-sync:focus-visible { outline:2px solid var(--studio-focus); outline-offset:3px; }
+.studio-main #screen-home #studio-refresh { min-height:30px; padding:4px 9px; font-size:11px; }
