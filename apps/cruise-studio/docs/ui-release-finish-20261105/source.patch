+            const center = !frame.closest('#tool-window-slot');
+            const style = doc.getElementById('studio-center-height');
+            if (!center) { style?.remove(); if (frame.style.height !== originalHeight) frame.style.height = originalHeight; return; }
+            if (!style) {
