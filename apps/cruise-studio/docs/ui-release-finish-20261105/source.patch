+.studio-header-title > div { display:contents; }
+.studio-header-title { display:grid; grid-template-columns:max-content 42px; gap:0 20px; }
+.studio-header-eyebrow { grid-column:1 / -1; }
+.studio-header-title h1 { grid-column:1; }
+.studio-header-sync { grid-column:2; align-self:center; }
+@media(max-width:600px){.studio-header-title{grid-template-columns:minmax(0,max-content) 42px;column-gap:12px;}}
